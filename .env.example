# Required for CrewAI Gemini agents (/report endpoint and evaluation/run_eval.py).
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# Gemini model name for CrewAI (check Google AI Studio for the current model name).
# crewai automatically prepends "gemini/" if omitted.
GEMINI_MODEL="gemini-3.8-flash"

# Gemini embedding model for RAG vector store (check Google AI Studio for current name).
# Falls back automatically to local TF-IDF embeddings if unavailable or on error.
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
